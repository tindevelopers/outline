# TLS termination for the multi-tenant Outline deployment at docs.tin.info.
#
# Tenant workspaces are served from <tenant>.docs.tin.info, because "docs" is
# not in RESERVED_SUBDOMAINS (shared/utils/domains.ts:102) and therefore forms
# the base domain that parseDomain() strips tenant labels from. A reserved label
# such as "app" would instead be discarded, making the base domain tin.info
# and silently moving every tenant onto the root zone.
#
# Both apex and wildcard are listed so a single certificate covers the app
# apex and every tenant. A wildcard alone would not cover docs.tin.info itself.
#
# The docs.roomzz.net grace-period redirect blocks were removed once every
# outbound reference had migrated (Cloudflare DNS for roomzz.net and the
# OAuth provider settings are handled separately, not by this file).
#
# Credentials come from the container environment: CF_API_TOKEN and ACME_EMAIL.
# The token needs only Zone -> DNS -> Edit on tin.info.
{
	email {env.ACME_EMAIL}
}

docs.tin.info, *.docs.tin.info {
	tls {
		dns cloudflare {env.CF_API_TOKEN}
	}

	encode zstd gzip

	# Collaborative editing holds a websocket open on /realtime
	# (server/services/websockets.ts:34). Caddy performs the upgrade
	# automatically; disabling buffering on this route keeps edit updates from
	# being held in the proxy.
	@realtime path /realtime /realtime/*
	reverse_proxy @realtime outline:3000 {
		flush_interval -1
		lb_try_duration 60s
		lb_try_interval 500ms
	}

	# Watchtower replaces the outline container on every deploy, leaving it
	# unreachable for a few seconds. Instead of answering 502, hold requests
	# and keep retrying until the new container accepts connections. Caddy
	# always retries requests that never reached the upstream, POSTs included,
	# so OAuth token refreshes made mid-deploy succeed rather than fail.
	reverse_proxy outline:3000 {
		lb_try_duration 60s
		lb_try_interval 500ms
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		# The editor renders user-supplied HTML, so stop the browser sniffing a
		# response into a different MIME type.
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
	}

	# Outline accepts uploads up to FILE_STORAGE_UPLOAD_MAX_SIZE (250 MB).
	# Caddy imposes no body limit, so nothing needs raising here. This is also
	# why the tenant records must stay DNS-only (grey cloud): proxying through
	# Cloudflare would cap uploads at 100 MB on a free plan.
}

# Bridges Outline's webhook deliveries to a Mattermost channel (Outline and
# Mattermost webhooks are not payload-compatible; see
# deploy/mattermost-relay/server.js). Covered by the *.docs.tin.info wildcard
# cert above, so this reuses that certificate rather than issuing a new one.
relay.docs.tin.info {
	tls {
		dns cloudflare {env.CF_API_TOKEN}
	}
	reverse_proxy mattermost-relay:8787
}
